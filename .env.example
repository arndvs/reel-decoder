# Models (override defaults if you have less VRAM or different preferences)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto              # auto | cpu | cuda | mps
WHISPER_COMPUTE_TYPE=auto        # auto | int8 | float16 | float32

VISION_MODEL=qwen2-vl:7b         # fallback: moondream:1.8b
CLASSIFIER_MODEL=qwen2.5:7b      # alternative: llama3.1:8b

OLLAMA_HOST=http://localhost:11434

# Pipeline tuning
SCENE_THRESHOLD=27.0             # PySceneDetect content threshold (lower = more cuts)
FRAME_SAMPLE_FPS=2.0             # Keyframe sampling rate
OCR_CONFIDENCE_THRESHOLD=0.5     # EasyOCR min confidence to keep a detection

# Paths
INPUTS_DIR=inputs/reels
OUTPUTS_DIR=outputs
